# DB test-suite config (tests/db) — copy to .env.test and fill in.
# Points at the HOSTED DEV Supabase project (no local Docker on dev machines).
# Find the API values in the dashboard: Project Settings → API.
#
# SECURITY: SUPABASE_SERVICE_ROLE_KEY bypasses RLS. It belongs ONLY in .env.test
# (git-ignored). NEVER put the service_role key in .env.local or any browser-shipped file.
SUPABASE_URL=https://<dev-project-ref>.supabase.co
SUPABASE_ANON_KEY=<dev-anon-key>
SUPABASE_SERVICE_ROLE_KEY=<dev-service-role-key>

# DB password (Project Settings → Database) — used by db:reset / db:types (--linked).
SUPABASE_DB_PASSWORD=<dev-db-password>

# DEV only. TRANSACTION pooler, port 6543 — READS ONLY (db:list / db:inspect).
# Outbound 5432 (session pooler) is blackholed on some networks, so writes never
# run from here: `migration up` goes through .github/workflows/db-migrate.yml.
# Password must be percent-encoded exactly once; tools/db/supabase-db.mjs passes
# this value through unchanged and never re-encodes it.
SUPABASE_DB_URL=

# Seeded accounts (see supabase/seed.sql). All seeded accounts use password: Password123!
# Used by tests/db/claims.test.ts to verify the Custom Access Token Hook.
TEST_OPERATOR_EMAIL=operator.amana@naql.dev
TEST_OPERATOR_PASSWORD=Password123!
TEST_ADMIN_EMAIL=admin@naql.dev
TEST_ADMIN_PASSWORD=Password123!
